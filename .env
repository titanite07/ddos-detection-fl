# OpenRouter API Configuration
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model Selection for LLM Agents
# Options: openai/gpt-4-turbo, anthropic/claude-3-opus, meta-llama/llama-3-70b-instruct, etc.
